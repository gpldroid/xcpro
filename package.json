{
  "name": "xconvert-pro",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint src tests astro.config.mjs eslint.config.mjs vitest.config.ts",
    "format": "prettier --write \"src/**/*\" \"tests/**/*\" \"*.{json,mjs,ts}\" \"docs/rebuild/**/*.md\"",
    "format:check": "prettier --check \"src/**/*\" \"tests/**/*\" \"*.{json,mjs,ts}\" \"docs/rebuild/**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run check && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/react": "7.1.5",
    "astro": "7.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "use-webmcp-tool": "0.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
