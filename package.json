{
  "name": "xconvert-pro",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint src astro.config.mjs eslint.config.mjs",
    "format": "prettier --write \"src/**/*\" \"*.{json,mjs}\" \"docs/rebuild/**/*.md\"",
    "format:check": "prettier --check \"src/**/*\" \"*.{json,mjs}\" \"docs/rebuild/**/*.md\"",
    "validate": "npm run check && npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.5",
    "astro": "^7.4.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
