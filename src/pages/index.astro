---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tools } from '../data/tools';
---
<BaseLayout title="XConvert Pro — Free Online Image Tools" description="Compress, resize, crop, convert, edit, and transform images with practical browser-based tools. Your files stay on your device.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'XConvert Pro', url: 'https://xconvert.pro/', description: 'Browser-based image editing and conversion tools.' })} />
  </Fragment>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">IMAGE TOOLS, WITHOUT THE FRICTION</span>
        <h1>Everything you need to edit images online</h1>
        <p class="hero-copy">A fast, simple image toolbox that is free to use. Compress, resize, crop, convert, edit and enhance images directly in your browser.</p>
        <div class="hero-actions"><a class="button button--primary" href="/tools/">Explore all tools <span aria-hidden="true">→</span></a><a class="button button--quiet" href="/about/">How it works</a></div>
        <div class="hero-note"><span>Browser-based processing</span><span>No account required</span><span>Original stays untouched</span></div>
      </div>
      <div class="hero-art" aria-hidden="true"><div class="art-card"><div class="art-card__top"><span>IMAGE WORKSPACE</span><span>01 / 10</span></div><div class="art-preview"><span class="art-preview__spark">✦</span></div><div class="art-card__bottom"><span>Optimized output</span><strong>Ready to export</strong></div></div></div>
    </div>
  </section>
  <section class="section section--surface">
    <div class="container">
      <div class="section-heading section-heading--toolkit"><div><span class="eyebrow">THE TOOLKIT</span><h2>Everything you need for everyday images</h2></div></div>
      <div class="tool-grid">
        {tools.map((tool, index) => <a class="tool-card" href={`/tools/${tool.slug}.html`}><span class="tool-card__icon" aria-hidden="true">{['↘','▣','⌗','⇄','◒','◌','↗','T','Aa','↻'][index]}</span><h3>{tool.shortTitle}</h3><p>{tool.description}</p><span class="tool-card__link">Open tool <span aria-hidden="true">→</span></span></a>)}
      </div>
    </div>
  </section>
  <section class="section workflow-section"><div class="container">
    <div class="section-heading section-heading--workflow"><div><span class="eyebrow">A SIMPLE WORKFLOW</span><h2>From original to finished file</h2></div></div>
    <div class="feature-grid">
      <article class="feature"><span class="feature__number">01</span><h3>Choose your image</h3><p>Select a local file or drop it into the workspace. Your original file stays untouched.</p></article>
      <article class="feature"><span class="feature__number">02</span><h3>Adjust and preview</h3><p>Use straightforward controls, fine-tune the result, and preview changes before exporting.</p></article>
      <article class="feature"><span class="feature__number">03</span><h3>Export your result</h3><p>Download a separate finished image in the supported output format, ready to use.</p></article>
    </div>
  </div></section>
  <section class="section"><div class="container cta-band"><div><h2>Ready to improve an image?</h2><p>Pick a tool and start with a file on your device.</p></div><a class="button" href="/tools/">Browse image tools <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
