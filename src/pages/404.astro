---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found | XConvert Pro" description="The requested page could not be found." noindex={true}>
  <section class="container page-hero" style="padding-block:100px;text-align:center">
    <span class="eyebrow">ERROR 404</span><h1>That page is not here.</h1><p style="margin-inline:auto">The link may be outdated or the page may have moved.</p>
    <a class="button button--primary" href="/">Return to XConvert Pro</a>
  </section>
</BaseLayout>
