{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowJs": false,
    "types": ["astro/client", "vitest/globals"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
