/* XConvert Pro — Tailwind-free fallback for standalone tools */
body[data-tool]{margin:0;min-width:320px;background:#f6f9fc;color:#0f172a;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
body[data-tool] .site-footer{margin-top:0}
body[data-tool] .tool-breadcrumb{width:min(1400px,calc(100% - 32px));margin:0 auto;padding:10px 0;font-size:.75rem;font-weight:700;color:#64748b}
body[data-tool] .tool-breadcrumb span{margin:0 7px}
body[data-tool] .tool-breadcrumb a{color:#64748b}
#toolWorkspace{position:relative;display:flex;flex-direction:column;min-height:calc(100vh - 118px);background:#0f172a;overflow:hidden}
#toolWorkspace>div:first-child{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 20px;background:#0b1730;color:#fff;border-bottom:1px solid #263653}
#toolWorkspace>div:first-child>div{display:flex;align-items:center;gap:14px;min-width:0}
#toolWorkspace>div:first-child h2{margin:0;font-size:1rem;font-weight:900}
#toolWorkspace>div:first-child p{margin:3px 0 0;color:#94a3b8;font-size:.72rem}
#toolWorkspace>div:first-child a{color:#94a3b8}
#activeToolIcon{color:#38bdf8;font-size:1.25rem}
#toolWorkspace>div:first-child button{border:0;border-radius:10px;padding:10px 13px;background:#17233b;color:#e2e8f0;font-weight:800;cursor:pointer}
#toolWorkspace>div:nth-child(2){display:flex;flex:1;min-height:520px;overflow:hidden}
#toolWorkspace>div:nth-child(2)>div:first-child{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px;background-color:#e2e8f0;background-image:linear-gradient(45deg,#cbd5e1 25%,transparent 25%),linear-gradient(-45deg,#cbd5e1 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#cbd5e1 75%),linear-gradient(-45deg,transparent 75%,#cbd5e1 75%);background-size:20px 20px;background-position:0 0,0 10px,10px -10px,-10px 0}
#dropzone{width:min(100%,680px);box-sizing:border-box;padding:44px;border:2px dashed #cbd5e1;border-radius:24px;background:#fff;color:#0f172a;text-align:center;box-shadow:0 20px 50px rgba(15,23,42,.16)}
#dropzone input{display:none}
#dropzone h2{margin:0 0 22px;font-size:clamp(2rem,5vw,3rem);font-weight:900;color:#0f172a}
#dropzone button{border:0;cursor:pointer;font-weight:900}
#dropzone button:first-of-type{padding:14px 24px;border-radius:14px;background:#0ea5e9;color:#fff;font-size:1rem}
#dropzone button:nth-of-type(2){width:50px;height:50px;margin-left:8px;border-radius:14px;background:#f1f5f9;color:#475569}
#dropzone p{margin:18px 0 0;color:#94a3b8;font-size:.82rem;font-weight:700}
#previewContainer:not(.hidden){display:flex;flex-direction:column;align-items:center;justify-content:center;max-width:100%;max-height:100%}
#previewContainer>div:first-child{position:relative;max-width:100%;overflow:hidden;border:1px solid #cbd5e1;border-radius:16px;box-shadow:0 20px 45px rgba(15,23,42,.2)}
#mainCanvas{display:block;max-width:100%;max-height:60vh}
#previewContainer>div:last-child{margin-top:14px;padding:10px 18px;border-radius:999px;background:rgba(255,255,255,.95);color:#475569;font-size:.72rem;font-weight:800}
#controlsSidebar:not(.hidden){display:flex}
#controlsSidebar{box-sizing:border-box;width:380px;flex:0 0 380px;padding:24px;background:#fff;color:#0f172a;border-left:1px solid #e2e8f0;flex-direction:column;justify-content:space-between;overflow:auto}
#controlsSidebar h3{margin:0 0 5px;font-size:1.15rem;font-weight:900}
#controlsSidebar p{margin:0;color:#94a3b8;font-size:.72rem}
#activeToolControls{display:grid;gap:18px;margin-top:20px}
#activeToolControls label{display:block;margin-bottom:7px;color:#334155;font-size:.78rem;font-weight:800}
#activeToolControls input,#activeToolControls select,#activeToolControls textarea{box-sizing:border-box;width:100%;min-height:42px;padding:9px 11px;border:1px solid #cbd5e1;border-radius:10px;background:#fff;color:#0f172a}
#controlsSidebar>div:last-child{padding-top:18px;margin-top:18px;border-top:1px solid #e2e8f0}
#controlsSidebar>div:last-child button{width:100%;border:0;border-radius:13px;padding:14px;background:#0ea5e9;color:#fff;font-weight:900;cursor:pointer}
.hidden{display:none!important}
#downloadModal:not(.hidden){display:flex}
#downloadModal{position:fixed;inset:0;z-index:200;align-items:center;justify-content:center;padding:16px;background:rgba(15,23,42,.78)}
#downloadModal>div{position:relative;width:min(100%,430px);box-sizing:border-box;padding:30px;border-radius:22px;background:#fff;color:#0f172a;text-align:center;box-shadow:0 30px 70px rgba(0,0,0,.25)}
#downloadModal a{display:block;padding:14px;border-radius:13px;background:#0ea5e9;color:#fff;text-decoration:none;font-weight:900}
#downloadModal button{border:0;cursor:pointer}
#toast:not(.hidden){display:flex}
#toast{position:fixed;right:22px;bottom:22px;z-index:210;align-items:center;gap:10px;padding:12px 16px;border-radius:13px;background:#0f172a;color:#fff;border:1px solid #263653}
body[data-tool]>section:not(.site-footer){background:#f6f9fc;color:#0f172a;padding:30px 16px}
body[data-tool]>section:not(.site-footer)>div{width:min(100%,1000px);margin:auto}
body[data-tool]>section:not(.site-footer) h2{margin:0 0 14px;font-size:1rem}
body[data-tool]>section:not(.site-footer) a{color:#0369a1;font-weight:800;text-decoration:none}
@media(max-width:900px){#toolWorkspace>div:nth-child(2){flex-direction:column}#controlsSidebar{width:100%;flex-basis:auto;border-left:0;border-top:1px solid #e2e8f0;max-height:55vh}}
@media(max-width:600px){body[data-tool] .tool-breadcrumb{width:calc(100% - 20px);font-size:.68rem}#toolWorkspace{min-height:calc(100vh - 100px)}#toolWorkspace>div:first-child{padding:12px 14px}#toolWorkspace>div:nth-child(2)>div:first-child{padding:16px;min-height:330px}#dropzone{padding:30px 18px}#dropzone h2{font-size:1.8rem}#controlsSidebar{padding:18px}.site-footer{margin-top:0}}

.dark body[data-tool]{background:#0b1329;color:#e2e8f0}
.dark body[data-tool]>section:not(.site-footer){background:#0b1329;color:#f8fafc}
.dark body[data-tool] .tool-breadcrumb{color:#cbd5e1}
.dark body[data-tool] .tool-breadcrumb a{color:#cbd5e1}
@media(max-width:600px){body[data-tool] .tool-breadcrumb{width:calc(100% - 20px)}}
